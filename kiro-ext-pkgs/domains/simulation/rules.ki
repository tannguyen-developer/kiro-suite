# kiro-suite/kiro-ext-pkgs/domains/simulation/rules.ki

META:
NAME=simulation_rules
VERSION=1.0.0
PURPOSE=correctness_fidelity_reproducibility_time_semantics_and_scope_boundary_rules_for_simulation_systems
SCOPE=all_simulation_systems
MODE=machine_first
FORMAT=directive_rules_priority_flags
PARENT=kiro-core@1
LAYER=tertiary
DEPENDS_ON=kiro-ext-pkgs/domains/simulation/entities.ki
DEPENDS_ON=kiro-ext-pkgs/domains/simulation/states.ki
DEPENDS_ON=kiro-core/principles.ki

##################################################
# SCOPE BOUNDARY RULE
##################################################

RULE=system_primary_objective_not_fidelity_to_real_world_process_model->out_of_scope

NOTE=a_system_qualifies_as_in_scope_only_when_its_primary_objective_is_fidelity_to_a_real_world_process_model
NOTE=systems_whose_primary_objective_is_entertainment_output_or_ml_environment_scaffolding_are_out_of_scope

##################################################
# CORRECTNESS AND FIDELITY RULES
##################################################

AXIOM=model_correctness_takes_precedence_over_execution_performance

RULE=optimization_that_alters_model_behavior_without_declared_Assumption->block
RULE=run_initiation_without_all_Assumptions_declared->block
RULE=numerical_computation_without_explicit_precision_strategy->block
RULE=emergent_behavior_not_derivable_from_declared_model_rules->flag_UNVERIFIED_BEHAVIOR_require_human_review
RULE=Simulation_Run_output_diverges_from_Validation_Dataset_beyond_tolerance->flag_VALIDATION_FAILED_block_promotion
RULE=stochastic_model_component_without_declared_probability_distribution->block

NUMERICAL_PRECISION_VALID_STRATEGIES=float64,fixed_point,arbitrary_precision

NOTE=model_correctness_takes_precedence_over_execution_performance_at_all_times
NOTE=any_optimization_that_alters_model_behavior_must_be_declared_as_an_explicit_Assumption_before_the_run_is_initiated
NOTE=all_Assumption_entities_must_be_declared_before_Simulation_Run_initiation_no_run_initiation_logic_may_bypass_assumption_declaration
NOTE=every_numerical_computation_must_declare_one_of_float64_fixed_point_or_arbitrary_precision_implicit_precision_selection_is_blocked
NOTE=emergent_behavior_not_derivable_from_declared_model_rules_is_flagged_UNVERIFIED_BEHAVIOR_and_requires_human_review_before_the_run_may_be_promoted
NOTE=Simulation_Run_output_that_diverges_from_Validation_Dataset_beyond_declared_tolerance_is_flagged_VALIDATION_FAILED_and_blocked_from_downstream_promotion
NOTE=stochastic_model_components_must_declare_an_explicit_probability_distribution_e.g._normal_uniform_poisson_exponential_undeclared_distributions_are_blocked

##################################################
# REPRODUCIBILITY RULES
##################################################

REUSE=kiro-core/principles.ki:CORRECT=deterministic_when_required

RULE=Simulation_Run_without_complete_Parameter_Set_Seed_model_version_software_version->block
RULE=stochastic_run_using_non_deterministic_source_outside_declared_stochastic_component->block
RULE=Simulation_Run_without_run_hash->block
RULE=two_runs_with_same_run_hash->return_cached_result_unless_FORCE_RERUN_set
RULE=Simulation_Run_model_version_floating_reference->block_require_pinned_version

run_hash_computation=hash(parameter_set_id+seed+model_id+model_version+software_version)

NOTE=every_Simulation_Run_must_record_its_complete_Parameter_Set_Seed_model_version_and_software_version_at_run_initiation
NOTE=stochastic_runs_must_not_use_non_deterministic_sources_such_as_wall_clock_time_or_system_entropy_outside_of_declared_stochastic_components
NOTE=every_Simulation_Run_record_must_include_a_run_hash_field_computed_from_parameter_set_id_plus_seed_plus_model_id_plus_model_version_plus_software_version
NOTE=run_hash_is_immutable_after_creation_and_enables_deduplication_and_audit
NOTE=two_runs_sharing_the_same_run_hash_must_return_the_cached_result_of_the_first_run_unless_FORCE_RERUN_is_explicitly_set_to_true
NOTE=model_version_must_be_pinned_at_Simulation_Run_creation_time_floating_references_such_as_latest_or_wildcard_are_blocked

##################################################
# TIME SEMANTICS RULES
##################################################

RULE=simulation_loop_with_implicit_or_hardcoded_time_advancement->block_require_explicit_Time_Step
RULE=stochastic_model_without_declared_Seed->block
RULE=PRNG_seeded_from_system_entropy_or_wall_clock->block
RULE=hybrid_mode_without_explicit_declaration_and_synchronization_rules->block

NOTE=simulation_loops_must_declare_an_explicit_Time_Step_implicit_or_hardcoded_time_advancement_is_blocked
NOTE=every_stochastic_model_must_declare_a_Seed_value_before_a_Simulation_Run_may_be_initiated
NOTE=pseudo_random_number_generators_must_be_seeded_from_the_declared_Seed_value_not_from_system_entropy_or_wall_clock_time
NOTE=models_that_mix_time_stepped_and_event_driven_semantics_must_declare_HYBRID_MODE_true_and_provide_explicit_synchronization_rules_between_the_two_time_domains

##################################################
# OBSERVABILITY
##################################################

REUSE=kiro-core/principles.ki:OPS=monitor_important_paths

NOTE=simulation_run_lifecycle_events_must_be_emitted_as_structured_log_entries_per_kiro_core_principles_OPS_monitor_important_paths
