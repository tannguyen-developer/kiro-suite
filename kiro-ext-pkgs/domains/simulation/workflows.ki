# kiro-suite/kiro-ext-pkgs/domains/simulation/workflows.ki

META:
NAME=simulation_workflows
VERSION=1.0.0
PURPOSE=canonical_simulation_lifecycle_workflow_phases_and_step_sequences
SCOPE=all_simulation_systems
MODE=machine_first
FORMAT=directive_rules_priority_flags
PARENT=kiro-core@1
LAYER=tertiary
DEPENDS_ON=kiro-ext-pkgs/domains/simulation/entities.ki
DEPENDS_ON=kiro-ext-pkgs/domains/simulation/states.ki
DEPENDS_ON=kiro-ext-pkgs/domains/simulation/rules.ki
DEPENDS_ON=kiro-ext-pkgs/domains/simulation/reliability.ki

##################################################
# GLOBAL WORKFLOW RULES
##################################################

RULE=workflow_step_without_emits_event->block

NOTE=every_workflow_step_must_declare_an_EMITS_EVENT_directive_naming_the_domain_event_emitted_for_downstream_consumers_steps_without_event_emission_are_blocked

##################################################
# WORKFLOW PHASE: initialization
##################################################

WORKFLOW=initialization
STEP=1:model_load
STEP=2:assumption_declaration
STEP=3:environment_setup
STEP=4:agent_instantiation
CONSTRAINT=assumption_declaration:NON_SKIPPABLE=true
EMITS_EVENT=model_load:simulation.model_loaded
EMITS_EVENT=assumption_declaration:simulation.assumptions_declared
EMITS_EVENT=environment_setup:simulation.environment_ready
EMITS_EVENT=agent_instantiation:simulation.agents_instantiated

NOTE=initialization_phase_prepares_the_Model_and_all_required_entities_before_execution_begins
NOTE=assumption_declaration_is_NON_SKIPPABLE_per_Requirement_8.2_and_entities.ki:RULE=Model_without_linked_Assumption->block_run_initiation
NOTE=model_load_must_resolve_a_pinned_model_version_per_rules.ki:RULE=Simulation_Run_model_version_floating_reference->block_require_pinned_version
NOTE=agent_instantiation_is_required_for_agent_based_simulation_types_and_is_a_no_op_for_DES_models_without_declared_Agents
NOTE=initialization_phase_transitions_Simulation_Run_from_pending_to_initializing_per_states.ki:STATE_MACHINE=Simulation_Run

##################################################
# WORKFLOW PHASE: configuration
##################################################

WORKFLOW=configuration
STEP=1:parameter_set_binding
STEP=2:seed_declaration
STEP=3:time_horizon_declaration
STEP=4:validation_dataset_binding
CONSTRAINT=seed_declaration:REQUIRED_FOR_STOCHASTIC_MODELS=true
EMITS_EVENT=parameter_set_binding:simulation.parameter_set_bound
EMITS_EVENT=seed_declaration:simulation.seed_declared
EMITS_EVENT=time_horizon_declaration:simulation.time_horizon_declared
EMITS_EVENT=validation_dataset_binding:simulation.validation_dataset_bound

NOTE=configuration_phase_binds_all_run_parameters_before_execution_begins
NOTE=seed_declaration_is_required_for_stochastic_models_per_Requirement_8.3_and_rules.ki:RULE=stochastic_model_without_declared_Seed->block
NOTE=parameter_set_binding_must_pin_the_Parameter_Set_at_binding_time_per_entities.ki:Parameter_Set:is_pinned=true
NOTE=time_horizon_declaration_must_declare_an_explicit_termination_condition_per_rules.ki:RULE=simulation_loop_with_implicit_or_hardcoded_time_advancement->block_require_explicit_Time_Step
NOTE=validation_dataset_binding_links_the_Validation_Dataset_reference_required_before_VALIDATED_promotion
NOTE=configuration_phase_transitions_Simulation_Run_from_initializing_to_running_per_states.ki:STATE_MACHINE=Simulation_Run

##################################################
# WORKFLOW PHASE: execution_loop
##################################################

WORKFLOW=execution_loop
STEP=1:state_advance
STEP=2:rules_evaluation
STEP=3:event_dispatch
STEP=4:bounds_check
CONSTRAINT=bounds_check:DISABLE=false
EMITS_EVENT=state_advance:simulation.state_advanced
EMITS_EVENT=rules_evaluation:simulation.rules_evaluated
EMITS_EVENT=event_dispatch:simulation.event_dispatched
EMITS_EVENT=bounds_check:simulation.bounds_checked

NOTE=execution_loop_phase_is_the_core_simulation_iteration_loop_repeating_until_termination_condition_is_met
NOTE=bounds_check_executes_on_every_iteration_and_cannot_be_disabled_per_Requirement_8.4
NOTE=bounds_check_enforces_edge-cases.ki:RULE=State_Vector_component_exceeds_declared_bounds->enter_BOUNDS_VIOLATED_halt_execution
NOTE=rules_evaluation_invokes_the_Rules_Engine_against_the_current_State_Vector_per_entities.ki:ENTITY=Rules_Engine
NOTE=event_dispatch_processes_all_Events_scheduled_at_the_current_simulation_time_per_entities.ki:ENTITY=Event
NOTE=state_advance_must_use_an_explicit_Time_Step_per_rules.ki:RULE=simulation_loop_with_implicit_or_hardcoded_time_advancement->block_require_explicit_Time_Step
NOTE=NaN_or_infinity_detected_during_state_advance_halts_the_run_immediately_per_rules.ki:RULE=NaN_or_infinity_in_State_Vector->halt_run_record_offending_component_transition_to_failed

##################################################
# WORKFLOW PHASE: observation_logging
##################################################

WORKFLOW=observation_logging
STEP=1:observation_capture
STEP=2:observation_write
STEP=3:run_hash_update
CONSTRAINT=observation_write:APPEND_ONLY=true
EMITS_EVENT=observation_capture:simulation.observation_captured
EMITS_EVENT=observation_write:simulation.observation_written
EMITS_EVENT=run_hash_update:simulation.run_hash_updated

NOTE=observation_logging_phase_records_the_current_State_Vector_snapshot_and_updates_the_run_hash
NOTE=observation_write_is_APPEND_ONLY_per_Requirement_8.5_and_entities.ki:ENTITY=Observation:APPEND_ONLY=true
NOTE=observation_write_must_complete_before_execution_loop_advances_per_reliability.ki:OBSERVATION_WRITE_CONSTRAINT
NOTE=fire_and_forget_observation_writes_are_blocked_per_reliability.ki:RULE=observation_write_fire_and_forget->block_require_durable_write_before_loop_advance
NOTE=run_hash_update_recomputes_the_run_hash_after_each_observation_to_maintain_audit_integrity_per_rules.ki:run_hash_computation

##################################################
# WORKFLOW PHASE: evaluation_validation
##################################################

WORKFLOW=evaluation_validation
STEP=1:output_aggregation
STEP=2:validation_dataset_comparison
STEP=3:divergence_assessment
STEP=4:run_status_update
CONSTRAINT=validation_dataset_comparison:REQUIRED_BEFORE_VALIDATED_PROMOTION=true
EMITS_EVENT=output_aggregation:simulation.output_aggregated
EMITS_EVENT=validation_dataset_comparison:simulation.validation_dataset_compared
EMITS_EVENT=divergence_assessment:simulation.divergence_assessed
EMITS_EVENT=run_status_update:simulation.run_status_updated
EMITS_EVENT=divergence_assessment:simulation.validation_failed

NOTE=evaluation_validation_phase_compares_run_output_against_the_Validation_Dataset_and_determines_run_status
NOTE=validation_dataset_comparison_is_required_before_a_run_may_be_promoted_to_VALIDATED_status_per_Requirement_8.6
NOTE=divergence_assessment_emits_simulation.validation_failed_when_output_diverges_beyond_declared_tolerance_per_reliability.ki:LIFECYCLE_EVENT=simulation.validation_failed
NOTE=simulation.validation_failed_blocks_downstream_promotion_per_rules.ki:RULE=Simulation_Run_output_diverges_from_Validation_Dataset_beyond_tolerance->flag_VALIDATION_FAILED_block_promotion
NOTE=run_status_update_sets_the_Simulation_Run_state_to_completed_or_flags_VALIDATION_FAILED_per_states.ki:STATE_MACHINE=Simulation_Run
NOTE=output_aggregation_collects_all_Observation_records_for_the_run_before_comparison

##################################################
# WORKFLOW PHASE: teardown
##################################################

WORKFLOW=teardown
STEP=1:resource_release
STEP=2:checkpoint_write
STEP=3:run_record_finalize
CONSTRAINT=run_record_finalize:TRANSITIONS_TO_TERMINAL_STATE=true
EMITS_EVENT=resource_release:simulation.resources_released
EMITS_EVENT=checkpoint_write:simulation.checkpoint_written
EMITS_EVENT=run_record_finalize:simulation.run_finalized

NOTE=teardown_phase_releases_all_reserved_resources_writes_a_final_checkpoint_and_transitions_the_Simulation_Run_to_a_terminal_state
NOTE=run_record_finalize_transitions_Simulation_Run_to_a_terminal_state_per_Requirement_8.8_and_states.ki:TERMINAL_STATES=completed,failed,cancelled
NOTE=resource_release_must_complete_before_run_record_finalize_per_reliability.ki:RULE=Simulation_Run_cancelled_without_resource_release_and_cancellation_record->block
NOTE=checkpoint_write_preserves_the_last_valid_State_Vector_per_reliability.ki:FAILURE_CHECKPOINT_MUST_PRESERVE=last_valid_State_Vector
NOTE=simulation.run_completed_is_emitted_by_run_record_finalize_when_Simulation_Run_transitions_to_completed_per_reliability.ki:LIFECYCLE_EVENT=simulation.run_completed
NOTE=simulation.run_failed_is_emitted_by_run_record_finalize_when_Simulation_Run_transitions_to_failed_per_reliability.ki:LIFECYCLE_EVENT=simulation.run_failed
NOTE=simulation.run_cancelled_is_emitted_by_run_record_finalize_when_Simulation_Run_transitions_to_cancelled_per_reliability.ki:LIFECYCLE_EVENT=simulation.run_cancelled
