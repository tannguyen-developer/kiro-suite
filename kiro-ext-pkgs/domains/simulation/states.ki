# kiro-suite/kiro-ext-pkgs/domains/simulation/states.ki

META:
NAME=simulation_states
VERSION=1.0.0
PURPOSE=state_machine_definitions_for_all_stateful_simulation_entities
SCOPE=all_simulation_systems
MODE=machine_first
FORMAT=directive_rules_priority_flags
PARENT=kiro-core@1
LAYER=tertiary
DEPENDS_ON=kiro-ext-pkgs/domains/simulation/entities.ki

##################################################
# GLOBAL STATE MACHINE RULES
##################################################

RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_new_record

INVALID_TRANSITION_FORMAT=INVALID_TRANSITION=<Entity>:<from_state>-><to_state>
TERMINAL_MUTATION_BLOCKED_FORMAT=TERMINAL_MUTATION_BLOCKED=<Entity>:<current_state>

NOTE=all_state_machines_below_inherit_the_two_global_rules_declared_above
NOTE=invalid_transitions_are_rejected_and_surfaced_as_errors_never_silently_accepted
NOTE=terminal_state_entities_must_not_be_mutated_directly_a_new_record_must_be_created_instead

##################################################
# STATE MACHINE: Simulation_Run
##################################################

STATE_MACHINE=Simulation_Run
STATES=pending,initializing,running,paused,completed,failed,cancelled
TERMINAL_STATES=completed,failed,cancelled
TRANSITION=pending->initializing
TRANSITION=initializing->running
TRANSITION=running->paused
TRANSITION=running->completed
TRANSITION=running->failed
TRANSITION=running->cancelled
TRANSITION=paused->running
TRANSITION=paused->cancelled
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_new_record

NOTE=Simulation_Run_terminal_states_are_completed_failed_cancelled
NOTE=a_paused_run_may_resume_to_running_or_be_cancelled_but_not_completed_directly
NOTE=a_running_run_may_transition_to_paused_completed_failed_or_cancelled
NOTE=once_in_a_terminal_state_the_Simulation_Run_record_is_immutable_create_a_new_record_to_retry

##################################################
# STATE MACHINE: Model
##################################################

STATE_MACHINE=Model
STATES=draft,validated,active,deprecated
TERMINAL_STATES=deprecated
TRANSITION=draft->validated
TRANSITION=validated->active
TRANSITION=active->deprecated
TRANSITION=draft->deprecated
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_new_record

NOTE=Model_terminal_state_is_deprecated
NOTE=draft_to_deprecated_is_a_fast_track_rejection_path
NOTE=validated_to_active_requires_arch_signoff_per_roles.ki
NOTE=active_to_deprecated_is_a_breaking_change_requiring_major_version_bump

##################################################
# STATE MACHINE: Experiment
##################################################

STATE_MACHINE=Experiment
STATES=defined,running,completed,failed
TERMINAL_STATES=completed,failed
TRANSITION=defined->running
TRANSITION=running->completed
TRANSITION=running->failed
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_new_record

NOTE=Experiment_terminal_states_are_completed_and_failed
NOTE=an_Experiment_groups_multiple_Simulation_Run_instances_for_parameter_sweep_or_comparative_analysis
NOTE=Experiment_transitions_to_failed_if_any_constituent_run_produces_an_unrecoverable_error

##################################################
# STATE MACHINE: Calibration_Config
##################################################

STATE_MACHINE=Calibration_Config
STATES=pending,running,completed,failed
TERMINAL_STATES=completed,failed
TRANSITION=pending->running
TRANSITION=running->completed
TRANSITION=running->failed
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_new_record

NOTE=Calibration_Config_terminal_states_are_completed_and_failed
NOTE=Calibration_is_a_first_class_lifecycle_phase_distinct_from_initialization_and_execution
NOTE=parameter_values_outside_declared_range_block_run_initiation_per_entities.ki

##################################################
# STATE MACHINE: Agent
##################################################

STATE_MACHINE=Agent
STATES=inactive,active,suspended,terminated
TERMINAL_STATES=terminated
TRANSITION=inactive->active
TRANSITION=active->suspended
TRANSITION=active->terminated
TRANSITION=suspended->active
TRANSITION=suspended->terminated
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_new_record

NOTE=Agent_state_machine_governs_agent_lifecycle_within_a_Simulation_Run
NOTE=Agent_terminal_state_is_terminated
NOTE=a_suspended_agent_may_resume_to_active_or_be_terminated
NOTE=Agent_state_is_scoped_to_a_single_Simulation_Run_instance
