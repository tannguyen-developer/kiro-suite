# kiro-suite/kiro-ext-pkgs/domains/simulation/reliability.ki

META:
NAME=simulation_reliability
VERSION=1.0.0
PURPOSE=checkpointing_run_isolation_observation_durability_cancellation_and_lifecycle_observability_for_simulation_runs
SCOPE=all_simulation_systems
MODE=machine_first
FORMAT=directive_rules_priority_flags
PARENT=kiro-core@1
LAYER=tertiary
DEPENDS_ON=kiro-core/architecture.ki
DEPENDS_ON=kiro-ext-pkgs/domains/simulation/entities.ki
DEPENDS_ON=kiro-ext-pkgs/domains/simulation/states.ki

##################################################
# LIFECYCLE OBSERVABILITY
##################################################

REUSE=kiro-core/principles.ki:OPS=monitor_important_paths

NOTE=all_Simulation_Run_lifecycle_events_must_be_emitted_as_structured_log_entries_per_kiro_core_principles_OPS_monitor_important_paths
NOTE=structured_log_entries_must_include_run_id_model_id_model_version_seed_run_hash_and_timestamp_at_minimum

##################################################
# LIFECYCLE EVENTS
##################################################

LIFECYCLE_EVENT=simulation.run_started
LIFECYCLE_EVENT=simulation.run_completed
LIFECYCLE_EVENT=simulation.run_failed
LIFECYCLE_EVENT=simulation.run_cancelled
LIFECYCLE_EVENT=simulation.validation_failed

RULE=Simulation_Run_lifecycle_event_not_emitted_as_structured_log_entry->block

NOTE=simulation.run_started_must_be_emitted_when_Simulation_Run_transitions_from_initializing_to_running
NOTE=simulation.run_completed_must_be_emitted_when_Simulation_Run_transitions_to_completed_terminal_state
NOTE=simulation.run_failed_must_be_emitted_when_Simulation_Run_transitions_to_failed_terminal_state
NOTE=simulation.run_cancelled_must_be_emitted_when_Simulation_Run_transitions_to_cancelled_terminal_state
NOTE=simulation.validation_failed_must_be_emitted_when_run_output_diverges_from_Validation_Dataset_beyond_declared_tolerance

##################################################
# CHECKPOINTING RULES
##################################################

CHECKPOINT_THRESHOLD=declared_duration_threshold_required_for_long_running_Simulation_Run

RULE=long_running_Simulation_Run_without_declared_checkpoint_interval->block

NOTE=every_Simulation_Run_expected_to_exceed_CHECKPOINT_THRESHOLD_must_declare_a_checkpoint_interval_before_run_initiation
NOTE=CHECKPOINT_THRESHOLD_is_a_configurable_duration_directive_that_operators_must_declare_for_their_simulation_infrastructure
NOTE=checkpoint_interval_enables_resume_from_last_valid_State_Vector_without_full_re_execution_from_initial_state
NOTE=AI_agents_must_not_generate_simulation_loops_without_a_declared_checkpoint_interval_for_runs_exceeding_the_declared_duration_threshold

##################################################
# FAILURE CHECKPOINT RULES
##################################################

RULE=Simulation_Run_fails_mid_execution->write_failure_checkpoint_before_terminating

FAILURE_CHECKPOINT_MUST_PRESERVE=last_valid_State_Vector
FAILURE_CHECKPOINT_MUST_RECORD=offending_component
FAILURE_CHECKPOINT_MUST_RECORD=time_step_at_failure
FAILURE_CHECKPOINT_MUST_RECORD=error_signal

NOTE=when_a_Simulation_Run_fails_mid_execution_the_system_must_write_a_failure_checkpoint_before_terminating
NOTE=the_failure_checkpoint_must_preserve_the_last_valid_State_Vector_so_that_the_run_may_be_diagnosed_and_optionally_resumed
NOTE=the_failure_checkpoint_must_record_the_offending_component_the_time_step_at_which_failure_occurred_and_the_error_signal_that_triggered_the_failure
NOTE=after_writing_the_failure_checkpoint_the_system_must_release_all_reserved_resources_and_transition_the_Simulation_Run_to_failed_state
NOTE=failure_checkpoint_write_must_complete_before_the_Simulation_Run_transitions_to_failed_state

##################################################
# RUN ISOLATION RULES
##################################################

RULE=shared_mutable_state_between_concurrent_Simulation_Run_instances->block

NOTE=each_Simulation_Run_instance_must_operate_on_its_own_isolated_copy_of_State_Vector_and_local_Agent_state
NOTE=shared_read_only_data_such_as_Model_definition_and_Parameter_Set_is_permitted_only_mutable_state_is_prohibited_from_being_shared
NOTE=AI_agents_must_not_generate_data_structures_or_storage_patterns_that_allow_one_Simulation_Run_to_read_or_write_the_mutable_state_of_another_concurrent_run

##################################################
# OBSERVATION DURABILITY RULES
##################################################

RULE=observation_write_fire_and_forget->block_require_durable_write_before_loop_advance

OBSERVATION_WRITE_CONSTRAINT=Observation_write_must_complete_before_execution_loop_advances

NOTE=Observation_records_must_be_written_to_durable_storage_and_the_write_must_be_confirmed_before_the_execution_loop_advances_to_the_next_time_step_or_event
NOTE=fire_and_forget_observation_writes_are_blocked_because_they_risk_data_loss_if_the_run_fails_between_the_write_dispatch_and_the_durable_commit
NOTE=durable_write_means_the_storage_layer_has_acknowledged_the_write_not_merely_that_the_write_was_dispatched
NOTE=this_rule_applies_to_all_Observation_records_regardless_of_simulation_type_or_time_semantics

##################################################
# CANCELLATION RULES
##################################################

RULE=Simulation_Run_cancelled_without_resource_release_and_cancellation_record->block

NOTE=when_a_Simulation_Run_is_cancelled_the_system_must_release_all_reserved_resources_before_transitioning_to_cancelled_state
NOTE=a_cancellation_record_must_be_written_documenting_the_run_id_the_time_of_cancellation_and_the_initiating_actor_or_signal
NOTE=resource_release_includes_compute_allocations_memory_reservations_locks_and_any_external_service_connections_held_by_the_run
NOTE=the_cancellation_record_write_and_resource_release_must_both_complete_before_the_Simulation_Run_transitions_to_cancelled_terminal_state
NOTE=AI_agents_must_not_generate_cancellation_logic_that_transitions_to_cancelled_state_without_first_completing_resource_release_and_writing_the_cancellation_record
