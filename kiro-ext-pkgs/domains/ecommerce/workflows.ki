# kiro-suite/kiro-ext-pkgs/domains/ecommerce/workflows.ki

META:
NAME=ecommerce_workflows
VERSION=1.0.0
PURPOSE=canonical_ecommerce_workflow_flows_and_step_sequences
SCOPE=all_ecommerce_systems
MODE=machine_first
FORMAT=directive_rules_priority_flags
PARENT=kiro-core@1
LAYER=tertiary
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/entities.ki
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/states.ki
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/rules.ki
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/reliability.ki

##################################################
# GLOBAL WORKFLOW RULES
##################################################

RULE=workflow_step_without_emits_event->block

NOTE=every_workflow_step_must_declare_an_EMITS_EVENT_directive_naming_the_domain_event_emitted_for_downstream_consumers_steps_without_event_emission_are_blocked

##################################################
# WORKFLOW: browse_to_cart
##################################################

WORKFLOW=browse_to_cart
STEP=1:catalog_search
STEP=2:product_detail
STEP=3:add_to_cart
STEP=4:cart_view
CONSTRAINT=add_to_cart:soft_inventory_availability_check_required
EMITS_EVENT=catalog_search:catalog.searched
EMITS_EVENT=product_detail:product.viewed
EMITS_EVENT=add_to_cart:cart.item_added
EMITS_EVENT=cart_view:cart.viewed

NOTE=browse_to_cart_represents_the_top_of_funnel_discovery_and_selection_flow_the_add_to_cart_step_requires_a_soft_inventory_availability_check_before_confirming_item_addition_this_is_a_non_locking_check_to_surface_out_of_stock_signals_early_without_reserving_inventory

##################################################
# WORKFLOW: cart_to_checkout
##################################################

WORKFLOW=cart_to_checkout
STEP=1:cart_review
STEP=2:address_entry
STEP=3:shipping_selection
STEP=4:order_preview
CONSTRAINT=order_preview:inventory_lock_acquired
EMITS_EVENT=cart_review:cart.reviewed
EMITS_EVENT=address_entry:address.entered
EMITS_EVENT=shipping_selection:shipping.selected
EMITS_EVENT=order_preview:order.previewed

NOTE=cart_to_checkout_transitions_the_customer_from_browsing_intent_to_purchase_intent_the_inventory_lock_must_be_acquired_at_the_order_preview_step_to_prevent_oversell_during_the_payment_entry_window_per_rules.ki:RULE=inventory_decrement_without_lock->block_require_inventory_lock_first

##################################################
# WORKFLOW: checkout_to_payment
##################################################

WORKFLOW=checkout_to_payment
STEP=1:payment_method_entry
STEP=2:fraud_assessment
STEP=3:payment_authorization
STEP=4:order_confirmation
CONSTRAINT=fraud_assessment:non_skippable
EMITS_EVENT=payment_method_entry:payment_method.entered
EMITS_EVENT=fraud_assessment:fraud.assessed
EMITS_EVENT=payment_authorization:payment.authorized
EMITS_EVENT=order_confirmation:order.confirmed

NOTE=checkout_to_payment_covers_the_payment_capture_intent_phase_fraud_assessment_is_declared_non_skippable_per_security.ki:RULE=payment_capture_without_fraud_signal_evaluation->block_no_implementation_may_bypass_or_short_circuit_the_fraud_assessment_step

##################################################
# WORKFLOW: payment_to_fulfillment
##################################################

WORKFLOW=payment_to_fulfillment
SAGA=true
STEP=1:payment_capture
STEP=2:inventory_decrement
STEP=3:fulfillment_creation
STEP=4:warehouse_notification
CONSTRAINT=inventory_decrement:inventory_lock_must_be_held_from_cart_to_checkout_order_preview_step
COMPENSATE=payment_capture:payment_void
COMPENSATE=inventory_decrement:inventory_restore
COMPENSATE=fulfillment_creation:fulfillment_cancelled
COMPENSATE=warehouse_notification:warehouse_notification_cancelled
EMITS_EVENT=payment_capture:payment.captured
EMITS_EVENT=inventory_decrement:inventory.decremented
EMITS_EVENT=fulfillment_creation:fulfillment.created
EMITS_EVENT=warehouse_notification:warehouse.notified

NOTE=payment_to_fulfillment_is_a_distributed_saga_spanning_payment_service_catalog_service_and_fulfillment_service_each_step_declares_a_compensating_transaction_to_enable_rollback_on_downstream_failure_per_reliability.ki:SAGA_STEP_declarations_compensating_transactions_are_invoked_in_reverse_order_by_the_saga_coordinator_on_failure

##################################################
# WORKFLOW: fulfillment_to_delivery
##################################################

WORKFLOW=fulfillment_to_delivery
STEP=1:picking
STEP=2:packing
STEP=3:dispatch
STEP=4:in_transit
STEP=5:delivered
EMITS_EVENT=picking:fulfillment.picking_started
EMITS_EVENT=packing:fulfillment.packed
EMITS_EVENT=dispatch:fulfillment.dispatched
EMITS_EVENT=in_transit:fulfillment.in_transit
EMITS_EVENT=delivered:fulfillment.delivered

NOTE=fulfillment_to_delivery_maps_directly_to_the_Fulfillment_state_machine_transitions_declared_in_states.ki_each_step_corresponds_to_a_state_transition_picking_maps_to_pending->picking_packing_to_picking->packed_dispatch_to_packed->shipped_in_transit_is_an_intermediate_tracking_event_and_delivered_maps_to_shipped->delivered

##################################################
# WORKFLOW: return_and_refund
##################################################

WORKFLOW=return_and_refund
STEP=1:return_request
STEP=2:return_authorization
STEP=3:item_receipt
STEP=4:refund_initiation
STEP=5:refund_capture
CONSTRAINT=refund_capture:original_payment_must_be_in_captured_state
EMITS_EVENT=return_request:return.requested
EMITS_EVENT=return_authorization:return.authorized
EMITS_EVENT=item_receipt:return.item_received
EMITS_EVENT=refund_initiation:refund.initiated
EMITS_EVENT=refund_capture:refund.captured

NOTE=return_and_refund_requires_the_original_Payment_record_to_be_in_captured_state_before_refund_capture_can_proceed_per_states.ki:STATE_MACHINE=Payment_TERMINAL_STATES=captured_the_refund_amount_must_not_exceed_the_original_captured_payment_amount_per_edge-cases.ki:RULE=refund_amount_exceeds_original_captured_payment->block
