# kiro-suite/kiro-ext-pkgs/domains/ecommerce/states.ki

META:
NAME=ecommerce_states
VERSION=1.0.0
PURPOSE=state_machine_definitions_for_all_stateful_ecommerce_entities
SCOPE=all_ecommerce_systems
MODE=machine_first
FORMAT=directive_rules_priority_flags
PARENT=kiro-core@1
LAYER=tertiary
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/entities.ki

##################################################
# GLOBAL STATE MACHINE RULES
##################################################

RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_compensating_entity

INVALID_TRANSITION_FORMAT=INVALID_TRANSITION=<Entity>:<from_state>-><to_state>
TERMINAL_MUTATION_BLOCKED_FORMAT=TERMINAL_MUTATION_BLOCKED=<Entity>:<current_state>

NOTE=all_state_machines_below_inherit_the_two_global_rules_declared_above
NOTE=invalid_transitions_are_rejected_and_surfaced_as_errors_never_silently_accepted
NOTE=terminal_state_entities_must_not_be_mutated_directly_use_compensating_entity_pattern

##################################################
# STATE MACHINE: Cart
##################################################

STATE_MACHINE=Cart
STATES=active,abandoned,converted,expired
TERMINAL_STATES=converted,abandoned,expired
TRANSITION=active->converted
TRANSITION=active->abandoned
TRANSITION=active->expired
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_compensating_entity

##################################################
# STATE MACHINE: Order
##################################################

STATE_MACHINE=Order
STATES=pending,confirmed,processing,shipped,delivered,cancelled,refunded
TERMINAL_STATES=delivered,cancelled,refunded
TRANSITION=pending->confirmed
TRANSITION=pending->cancelled
TRANSITION=confirmed->processing
TRANSITION=confirmed->cancelled
TRANSITION=processing->shipped
TRANSITION=processing->cancelled
TRANSITION=shipped->delivered
TRANSITION=shipped->cancelled
TRANSITION=delivered->refunded
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_compensating_entity

##################################################
# STATE MACHINE: Payment
##################################################

STATE_MACHINE=Payment
STATES=pending,authorized,captured,failed,refunded,voided
TERMINAL_STATES=captured,failed,refunded,voided
TRANSITION=pending->authorized
TRANSITION=pending->failed
TRANSITION=authorized->captured
TRANSITION=authorized->voided
TRANSITION=authorized->failed
TRANSITION=captured->refunded
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_compensating_entity

##################################################
# STATE MACHINE: PaymentIntent
##################################################

STATE_MACHINE=PaymentIntent
STATES=created,pending,authorized,expired,cancelled
TERMINAL_STATES=authorized,expired,cancelled
TRANSITION=created->pending
TRANSITION=created->cancelled
TRANSITION=pending->authorized
TRANSITION=pending->expired
TRANSITION=pending->cancelled
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_compensating_entity

##################################################
# STATE MACHINE: Fulfillment
##################################################

STATE_MACHINE=Fulfillment
STATES=pending,picking,packed,shipped,delivered,returned
TERMINAL_STATES=delivered,returned
TRANSITION=pending->picking
TRANSITION=picking->packed
TRANSITION=packed->shipped
TRANSITION=shipped->delivered
TRANSITION=shipped->returned
TRANSITION=delivered->returned
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_compensating_entity

##################################################
# STATE MACHINE: Refund
##################################################

STATE_MACHINE=Refund
STATES=pending,processing,completed,failed
TERMINAL_STATES=completed,failed
TRANSITION=pending->processing
TRANSITION=pending->failed
TRANSITION=processing->completed
TRANSITION=processing->failed
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_compensating_entity

##################################################
# STATE MACHINE: Inventory
##################################################

STATE_MACHINE=Inventory
STATES=available,reserved,depleted,discontinued
TERMINAL_STATES=discontinued
TRANSITION=available->reserved
TRANSITION=available->depleted
TRANSITION=available->discontinued
TRANSITION=reserved->available
TRANSITION=reserved->depleted
TRANSITION=depleted->available
TRANSITION=depleted->discontinued
RULE=invalid_transition_attempted->reject_and_surface_error
RULE=terminal_state_mutation_attempted->block_require_compensating_entity
