# kiro-suite/kiro-ext-pkgs/domains/ecommerce/edge-cases.ki

META:
NAME=ecommerce_edge_cases
VERSION=1.0.0
PURPOSE=failure_mode_and_edge_case_constraints_for_ecommerce_systems
SCOPE=all_ecommerce_systems
MODE=machine_first
FORMAT=directive_rules_priority_flags
PARENT=kiro-core@1
LAYER=tertiary
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/entities.ki
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/states.ki
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/rules.ki
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/reliability.ki
DEPENDS_ON=kiro-ext-pkgs/domains/ecommerce/workflows.ki

##################################################
# INVENTORY CONFLICT (Req 10.2)
##################################################

RULE=inventory_out_of_stock_between_lock_and_decrement->cancel_affected_order_line_item_notify_customer_trigger_partial_fulfillment

NOTE=when_inventory_goes_out_of_stock_between_lock_acquisition_and_decrement_cancel_the_affected_OrderLineItem_notify_the_customer_and_trigger_partial_fulfillment_logic

##################################################
# PAYMENT AUTH/CAPTURE FAILURE (Req 10.3)
##################################################

RULE=payment_authorization_succeeded_but_capture_failed->void_authorization_return_order_to_pending

NOTE=when_payment_authorization_succeeds_but_capture_fails_void_the_authorization_and_return_the_Order_to_pending_state_for_retry

##################################################
# CONCURRENT COUPON ABUSE (Req 10.4)
##################################################

RULE=concurrent_single_use_coupon_application->require_optimistic_locking_on_coupon_redemption_record

NOTE=when_two_concurrent_sessions_attempt_to_apply_the_same_single_use_Coupon_optimistic_locking_on_the_Coupon_redemption_record_prevents_double_application

##################################################
# FRAUD SIGNAL THRESHOLD (Req 10.5)
##################################################

RULE=fraud_signal_score_exceeds_threshold->enter_pending_review_block_payment_capture_until_review_complete

NOTE=when_fraud_signal_score_exceeds_the_declared_threshold_the_Order_enters_pending_review_state_and_payment_capture_is_blocked_until_manual_or_automated_review_completes

##################################################
# PARTIAL SHIPMENT (Req 10.6)
##################################################

RULE=partial_shipment_some_fulfillment_items_pending->keep_order_in_processing_until_all_fulfillment_items_terminal

NOTE=when_a_partial_shipment_occurs_some_FulfillmentItem_records_shipped_others_pending_the_Order_must_remain_in_processing_state_until_all_FulfillmentItem_records_reach_terminal_state

##################################################
# REFUND UPPER-BOUND (Req 10.7)
##################################################

RULE=refund_amount_exceeds_original_captured_payment->block
CONSTRAINT=refund_amount<=original_captured_payment_amount

NOTE=refund_amounts_are_validated_against_the_original_captured_payment_amount_over_refund_beyond_the_original_transaction_value_is_not_permitted

##################################################
# SESSION EXPIRY DURING CHECKOUT (Req 10.8)
##################################################

RULE=customer_session_expires_during_checkout->release_inventory_lock_return_cart_to_active

NOTE=when_a_customer_session_expires_during_checkout_the_Inventory_Lock_must_be_released_and_the_Cart_must_return_to_active_state

##################################################
# CONCURRENT CART MODIFICATION (Req 10.1)
##################################################

RULE=concurrent_cart_modification_detected->require_optimistic_locking_on_cart_record

NOTE=concurrent_cart_modifications_require_optimistic_locking_on_the_Cart_record_to_prevent_lost_updates
