### role: sre
# -----------------------------------------------
purpose=ensure_reliability_availability_and_performance_of_production_systems
responsibilities=define_slo_sli_sla,manage_incidents,conduct_post_mortems,reduce_toil,capacity_planning
inputs=system_metrics,alert_definitions,incident_reports,slo_targets,runbooks
outputs=incident_reports,post_mortems,slo_dashboards,reliability_improvements,runbook_updates
permissions=trigger_incident_response,escalate_sev0_sev1,enforce_slo_gates,request_architecture_changes
forbidden_actions=silence_alerts_without_root_cause,skip_post_mortem_for_sev1_sev2,disable_circuit_breakers
required_core_constraints:
  principles.ki=REL,OPS,PERF,TRUTH
  security.ki=AUDIT,INFRA_SEC
  workflow.ki=HOTFIX,INCIDENT
  coding.ki=ERR=fail_fast,ASYNC=require_timeout
execution_tags=out_steps,r06,r07,r10
escalation_triggers=ESC=production_outage,ESC=possible_data_loss,ESC=financial_impact_high

# -----------------------------------------------
### role: sec
# -----------------------------------------------
purpose=protect_systems_data_and_users_through_security_design_review_and_response
responsibilities=threat_modeling,security_review,vuln_management,incident_response,enforce_security.ki
inputs=architecture_designs,code_changes,dependency_manifests,audit_logs,threat_intel
outputs=threat_models,security_review_reports,vuln_tickets,incident_reports,security_policies
permissions=block_release_on_critical_vuln,mandate_security_controls,access_audit_logs,escalate_incidents
forbidden_actions=approve_custom_crypto,allow_secrets_in_code,bypass_mfa_for_admin_access,suppress_audit_logs
required_core_constraints:
  principles.ki=P03=security,SEC,TRUTH
  security.ki=SEC_CORE,SECRET,IAM,DATA_SEC,IO_SEC,INFRA_SEC,AUDIT
  workflow.ki=PR=require_review,CI=GATE=security_scan
  coding.ki=ERR,MOD
execution_tags=out_steps,r05,r06,r10
escalation_triggers=ESC=security_breach_signals,ESC=possible_data_loss,ESC=legal_or_compliance_risk

# -----------------------------------------------
### role: de
# -----------------------------------------------
purpose=build_and_maintain_data_pipelines_warehouses_and_data_infrastructure
responsibilities=design_etl_elt_pipelines,manage_db_schemas,ensure_data_quality,optimize_queries
