responsibilities=prompt_design,evaluation_framework,prompt_versioning,safety_testing,documentation
inputs=task_requirements,model_capabilities,evaluation_criteria,safety_constraints
outputs=versioned_prompts,evaluation_reports,prompt_libraries,safety_test_results
