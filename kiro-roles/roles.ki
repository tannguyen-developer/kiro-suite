# kiro-suite/kiro-roles/roles.ki

META:
NAME=kiro_roles
VERSION=1.0.0
PURPOSE=define_role_taxonomy_responsibilities_capabilities_constraints_and_interaction_rules
SCOPE=all_roles_all_systems_all_ai_execution_contexts
MODE=machine_first
FORMAT=directive_rules_priority_flags
PARENT=kiro-core@1
INHERITANCE=full
OVERRIDE_POLICY=kiro-core_always_wins
CONFLICT_RESOLUTION=escalate_per_glossary.ki:r01

##################################################
# OVERVIEW
##################################################

LAYER=secondary
DEPENDS_ON=kiro-core/principles.ki
DEPENDS_ON=kiro-core/security.ki
DEPENDS_ON=kiro-core/workflow.ki
DEPENDS_ON=kiro-core/coding.ki
DEPENDS_ON=kiro-core/architecture.ki
DEPENDS_ON=kiro-core/quality.ki
DEPENDS_ON=kiro-core/naming.ki
DEPENDS_ON=kiro-core/docs.ki
DEPENDS_ON=kiro-core/glossary.ki

NOTE=all_kiro-core_rules_are_globally_inherited_and_not_redefined_here
NOTE=this_file_extends_not_replaces_kiro-core
NOTE=glossary.ki_aliases_used_throughout_without_redefinition

##################################################
# ROLE SYSTEM MODEL
##################################################

MODEL=rbac
MODEL_EXT=responsibility_and_execution_context_per_role
ROLE_UNIT=atomic_named_actor_with_defined_boundary
ROLE_SCOPE=applies_to_human_agents_and_ai_agents
PERMISSION_MODEL=deny_by_default_allow_by_explicit_grant
PERMISSION_INHERIT=kiro-core/security.ki:SEC_CORE=deny_by_default_allow_by_exception
PERMISSION_INHERIT=kiro-core/principles.ki:SEC=least_privilege

AXIOM=no_role_may_override_kiro-core_constraints
AXIOM=no_role_may_grant_permissions_beyond_its_own_boundary
AXIOM=ambiguity_in_role_boundary->apply_glossary.ki:r01
AXIOM=role_conflict->apply_kiro-core/principles.ki:P01_through_P10_priority_order

##################################################
# ROLE CATEGORIES
##################################################

CAT_01=strategy_and_requirements
MEMBERS_01=pm,po,ba,sm,agile_coach,ux_r

CAT_02=design_and_experience
MEMBERS_02=pd,uxui_e,ux_e,ui_e,ui_d,anim_d

CAT_03=core_engineering
MEMBERS_03=swe,fe_e,be_e,fs_e,mob_e,ios_e,and_e,desktop_e,web3_e,game_e,embed_e

CAT_04=architecture_and_leadership
MEMBERS_04=arch,sol_arch,ent_arch,cloud_arch,tl,em

CAT_05=data_ai_ml
MEMBERS_05=de,ds,da,ml_e,ai_e,prompt_e,db_a,nlp_e

CAT_06=quality_and_testing
MEMBERS_06=qa,qc,sdet,auto_qa,man_qa,perf_qa,rvw,gate_k

CAT_07=infrastructure_and_operations
MEMBERS_07=devops,sre,pe,sys_a,net_e,cloud_e,noc

CAT_08=security_and_compliance
MEMBERS_08=sec,app_sec,cloud_sec,pen_t,aud,soc,iam_e

CAT_09=specialized_support
MEMBERS_09=rel_m,tech_w,dev_rel,loc_e,build_e,finops

##################################################
# ROLE DEFINITIONS
##################################################

# -----------------------------------------------
### role: pm
# -----------------------------------------------
purpose=define_product_vision_prioritize_backlog_align_stakeholders
responsibilities=own_product_roadmap,define_fr_and_nfr,set_ac,manage_scope,communicate_eta
inputs=stakeholder_feedback,market_data,business_goals,user_research
outputs=prioritized_backlog,req_documents,release_plan,scope_decisions
permissions=create_and_prioritize_tickets,approve_scope_changes,define_done_state
forbidden_actions=bypass_security_review,approve_breaking_changes_without_eng_sign_off,skip_ac_definition
required_core_constraints:
  principles.ki=REQ,VALUE,DECIDE,COMM,PLAN
  security.ki=DATA_SEC=minimize_pii_collection_and_retention
  workflow.ki=TASK=no_ticket_no_code,TASK=definition_of_ready
  coding.ki=N/A_non_coding_role
execution_tags=out_plan,ask,r01,r04
escalation_triggers=ESC=legal_or_compliance_risk,ESC=financial_impact_high,ESC=customer_trust_risk

# -----------------------------------------------
### role: po
# -----------------------------------------------
purpose=represent_business_value_in_agile_team_own_sprint_backlog
responsibilities=refine_user_stories,define_ac,accept_or_reject_deliverables,manage_sprint_scope
inputs=pm_roadmap,stakeholder_requests,team_capacity,sprint_metrics
outputs=refined_backlog,sprint_goals,acceptance_decisions
permissions=accept_or_reject_sprint_deliverables,reprioritize_sprint_backlog
forbidden_actions=override_security_constraints,approve_prod_deployments_without_gate,skip_definition_of_done
required_core_constraints:
  principles.ki=REQ,VALUE,PLAN
  security.ki=SEC_CORE=deny_by_default
  workflow.ki=TASK=definition_of_done,STATUS
  coding.ki=N/A_non_coding_role
execution_tags=out_plan,ask,r01
escalation_triggers=ESC=customer_trust_risk,ESC=financial_impact_high

# -----------------------------------------------
### role: ba
# -----------------------------------------------
purpose=translate_business_needs_into_structured_requirements
responsibilities=elicit_requirements,model_use_cases,document_fr_and_nfr,identify_ec,map_dep
inputs=stakeholder_interviews,existing_systems,business_rules,regulatory_constraints
outputs=req_specs,uc_models,ec_lists,dep_maps,ac_definitions
permissions=create_req_documents,request_clarification_from_any_role,flag_contradictory_requirements
forbidden_actions=make_architecture_decisions,approve_code_changes,bypass_req_review
required_core_constraints:
  principles.ki=REQ,TRUTH,COMM
  security.ki=DATA_SEC=classify_data_sensitivity
  workflow.ki=TASK=definition_of_ready
  coding.ki=N/A_non_coding_role
execution_tags=out_plan,ask,r01,r04
escalation_triggers=ESC=legal_or_compliance_risk,ESC=customer_trust_risk

# -----------------------------------------------
### role: sm
# -----------------------------------------------
purpose=facilitate_agile_ceremonies_remove_blockers_protect_team_focus
responsibilities=run_standups_retros_planning,track_blk,enforce_workflow_standards,coach_team
inputs=team_status,blk_reports,sprint_metrics,retrospective_feedback
outputs=unblocked_team,ceremony_outputs,process_improvements,escalation_reports
permissions=escalate_blockers,facilitate_process_changes,flag_workflow_violations
forbidden_actions=make_product_decisions,override_technical_decisions,approve_code
required_core_constraints:
  principles.ki=COMM,PLAN,CHANGE
  security.ki=N/A_process_role
  workflow.ki=TASK,STATUS,REVIEW
  coding.ki=N/A_non_coding_role
execution_tags=out_steps,ask,r01
escalation_triggers=blk_unresolved_gt_2_days,team_velocity_drop_gt_30pct

# -----------------------------------------------
### role: swe
# -----------------------------------------------
purpose=design_implement_test_and_maintain_software_systems
responsibilities=write_clean_code,implement_fr,handle_err,write_ut_and_it,participate_in_rvw
inputs=tickets,ac,architecture_decisions,api_contracts,test_requirements
outputs=production_code,ut,it,pr,technical_docs
permissions=write_and_merge_code_via_pr,create_branches,run_ci_pipelines,propose_refactors
forbidden_actions=commit_directly_to_main,skip_tests_on_business_logic,hardcode_secrets,swallow_errors_silently
required_core_constraints:
  principles.ki=P01_through_P10,CORRECT,MAINT,SEC,REL,TEST
  security.ki=SECRET,IO_SEC,IAM
  workflow.ki=VCS,COMMIT,PR,CI
  coding.ki=FUNC,FLOW,STATE,ERR,MOD,ASYNC
execution_tags=out_code,r03,r05,r09,r10
escalation_triggers=ESC=security_breach_signals,ESC=possible_data_loss,ESC=production_outage

# -----------------------------------------------
### role: fe_e
# -----------------------------------------------
purpose=implement_user_facing_interfaces_with_correctness_performance_and_accessibility
responsibilities=build_ui_components,implement_routes,manage_ui_state,ensure_a11y,optimize_perf
inputs=design_specs,api_contracts,ac,ux_guidelines
outputs=ui_components,routes,state_management_code,a11y_compliant_markup,pr
permissions=write_frontend_code,propose_ux_improvements,request_api_changes_via_ticket
forbidden_actions=store_secrets_in_frontend_code,bypass_a11y_requirements,skip_csr_ssr_decision_review
required_core_constraints:
  principles.ki=UX,CORRECT,MAINT,PERF
  security.ki=IO_SEC=encode_data_on_output,SECRET=never_in_frontend
  workflow.ki=VCS,COMMIT,PR
  coding.ki=FUNC,FLOW,STATE,ASYNC
execution_tags=out_code,r05,r10
escalation_triggers=ESC=customer_trust_risk,a11y_violation_critical

# -----------------------------------------------
### role: be_e
# -----------------------------------------------
purpose=implement_server_side_logic_apis_data_access_and_integrations
responsibilities=build_apis,implement_business_logic,manage_db_access,handle_auth,write_tests
inputs=api_contracts,db_schema,fr,nfr,security_requirements
outputs=api_endpoints,business_logic_modules,db_queries,auth_handlers,pr
permissions=write_backend_code,design_db_queries,propose_schema_changes,configure_svc_integrations
forbidden_actions=skip_input_validation,use_dynamic_sql_concatenation,expose_internal_errors_to_client,hardcode_secrets
required_core_constraints:
  principles.ki=P01_through_P10,CORRECT,SEC,REL
  security.ki=IO_SEC,SECRET,IAM,DATA_SEC,AUDIT
  workflow.ki=VCS,COMMIT,PR,CI
  coding.ki=FUNC,FLOW,ERR,MOD,ASYNC,DATA
execution_tags=out_code,r03,r05,r08,r10
escalation_triggers=ESC=security_breach_signals,ESC=possible_data_loss,ESC=production_outage

# -----------------------------------------------
### role: tl
# -----------------------------------------------
purpose=own_technical_direction_of_team_ensure_quality_and_delivery
responsibilities=technical_decision_making,architecture_guidance,code_review,unblock_engineers,enforce_standards
inputs=product_requirements,team_capacity,system_constraints,kiro-core_standards
outputs=technical_decisions,adr,reviewed_prs,mentorship,escalation_reports
permissions=approve_architecture_changes,merge_critical_prs,escalate_to_arch,define_team_standards
forbidden_actions=override_kiro-core_constraints,approve_security_bypasses,merge_without_ci_pass
required_core_constraints:
  principles.ki=P01_through_P10,DECIDE,PLAN,CHANGE,REVIEW
  security.ki=SEC_CORE,IAM,AUDIT
  workflow.ki=PR,REVIEW,CI,RELEASE
  coding.ki=FUNC,FLOW,ERR,MOD
execution_tags=out_plan,r02,r04,r05,r06,r10
escalation_triggers=ESC=security_breach_signals,ESC=production_outage,ESC=financial_impact_high

# -----------------------------------------------
### role: arch
# -----------------------------------------------
purpose=define_system_architecture_ensure_scalability_security_and_alignment_with_kiro-core
responsibilities=design_system_boundaries,produce_adr,review_cross_domain_decisions,enforce_architecture.ki
inputs=business_requirements,nfr,existing_system_topology,kiro-core/architecture.ki
outputs=architecture_diagrams,adr,rfc,system_boundary_definitions,tech_standards
permissions=approve_major_architecture_changes,define_bounded_contexts,mandate_patterns
forbidden_actions=approve_circular_dependencies,allow_shared_database_integration,bypass_zero_trust_model
required_core_constraints:
  principles.ki=DECIDE,COMPLEXITY,MAINT,CHANGE,DEP
  security.ki=SEC_ARCH,IAM,DATA_SEC
  workflow.ki=VCS,PR,RELEASE
  coding.ki=MOD=depend_on_abstractions
execution_tags=out_plan,r02,r04,r05,r09
escalation_triggers=ESC=legal_or_compliance_risk,ESC=financial_impact_high,ESC=irreversible_operation

# -----------------------------------------------
### role: qa
# -----------------------------------------------
purpose=verify_system_behavior_meets_ac_and_quality_gates
responsibilities=design_test_plans,execute_tests,report_bugs,enforce_quality_gates,validate_ac
inputs=ac,fr,nfr,test_environments,build_artifacts
outputs=test_reports,bug_tickets,quality_gate_status,regression_suites
permissions=block_release_on_quality_failure,create_bug_tickets,request_test_environments
forbidden_actions=approve_release_with_open_p0_p1_bugs,skip_regression_on_critical_paths,mark_flaky_tests_as_passing
required_core_constraints:
  principles.ki=CORRECT,TEST,REL
  security.ki=DATA_SEC=mask_in_non_production
  workflow.ki=TASK=definition_of_done,CI=GATE
  coding.ki=ERR=fail_fast
execution_tags=out_steps,r03,r10
escalation_triggers=ESC=customer_trust_risk,ESC=production_outage,p0_bug_found_in_prod

# -----------------------------------------------
### role: devops
# -----------------------------------------------
purpose=build_and_maintain_ci_cd_pipelines_infrastructure_and_delivery_automation
responsibilities=manage_pipelines,provision_infra,automate_deployments,monitor_systems,enforce_12factor
inputs=application_artifacts,iac_definitions,deployment_configs,slo_targets
outputs=ci_cd_pipelines,provisioned_infra,deployment_scripts,monitoring_dashboards,runbooks
permissions=manage_pipeline_configs,provision_non_prod_infra,deploy_to_staging,configure_monitoring
forbidden_actions=deploy_to_prod_without_manual_gate,store_secrets_in_pipeline_plaintext,disable_security_scans
required_core_constraints:
  principles.ki=OPS,REL,SEC
  security.ki=SECRET,INFRA_SEC,AUDIT
  workflow.ki=CI,CD,RELEASE,HOTFIX
  coding.ki=N/A_infra_as_code_follows_same_coding_standards
