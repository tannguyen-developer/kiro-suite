# kiro-suite/kiro-core/docs.ki

META:
NAME=global_documentation_standards
VERSION=1
PURPOSE=enforce_discoverable_and_maintainable_documentation
SCOPE=all_projects_all_engineers_all_repositories
MODE=machine_first
FORMAT=directive_rules_priority_flags

##################################################
# CORE DOCUMENTATION MINDSET
##################################################

DOC_CORE=docs_as_code_preferred_store_in_version_control
DOC_CORE=single_source_of_truth_avoid_duplication
DOC_CORE=optimize_for_the_reader_not_the_writer
DOC_CORE=outdated_docs_are_worse_than_no_docs
DOC_CORE=documentation_is_a_first_class_deliverable

RULE=doc_conflicts_with_code->code_is_truth_update_doc
RULE=information_duplicated_in_wiki_and_repo->delete_wiki_link_to_repo

##################################################
# REPOSITORY LEVEL (README)
##################################################

REPO=every_repository_must_have_a_readme
README=must_state_what_the_project_does_in_one_sentence
README=must_list_prerequisites_and_setup_steps
README=must_provide_local_execution_command
README=must_identify_code_owners_or_maintainer_team

RULE=readme_lacks_setup_instructions->block_pr_for_new_repo
RULE=setup_step_fails_for_new_hire->fix_readme_immediately

##################################################
# ARCHITECTURE & DECISION RECORDS
##################################################

ARCH=record_significant_decisions_via_adr
ADR=architecture_decision_record
ADR_FORMAT=must_include_context_decision_and_consequences
ADR_STATE=proposed_accepted_deprecated_superseded
RFC=request_for_comments_used_for_proposal_before_adr

RULE=major_dependency_added->require_adr
RULE=system_boundary_changed->require_adr
RULE=database_technology_changed->require_adr

##################################################
# API & INTEGRATION DOCUMENTATION
##################################################

API=public_and_internal_apis_must_be_documented
API_REST=use_openapi_swagger_specification
API_GRAPHQL=use_inline_schema_descriptions
API_GRPC=use_protobuf_comments
API_GEN=generate_docs_from_code_wherever_possible

RULE=new_api_endpoint_added->require_openapi_spec_update
RULE=api_breaking_change->require_changelog_update_and_version_bump

##################################################
# CODE LEVEL & INLINE COMMENTS
##################################################

INLINE=document_why_not_what
INLINE=document_hacks_workarounds_and_tech_debt_with_ticket_links
INLINE=use_standard_docstrings_jsdoc_pydoc_godoc
INLINE=keep_comments_close_to_the_code_they_describe

RULE=comment_explains_basic_language_syntax->delete_comment
RULE=todo_comment_without_ticket_link->warn_and_request_link

##################################################
# OPERATIONS & RUNBOOKS
##################################################

OPS=every_production_service_must_have_a_runbook
RUNBOOK=must_list_critical_alerts_and_what_they_mean
RUNBOOK=must_provide_step_by_step_troubleshooting_guides
RUNBOOK=must_list_escalation_contacts
PLAYBOOK=document_repeatable_tasks_deploy_rollback_restore

RULE=service_alert_fires_but_not_in_runbook->add_to_runbook_post_incident
RULE=runbook_step_requires_tribal_knowledge->rewrite_to_be_explicit

##################################################
# MAINTENANCE & LIFECYCLE
##################################################

MAINT=review_core_docs_quarterly
MAINT=deprecate_docs_clearly_when_system_is_sunset
MAINT=use_markdown_as_the_default_format
MAINT=use_mermaid_js_or_plantuml_for_diagrams_as_code

RULE=doc_last_updated_gt_365_days->flag_for_freshness_review
RULE=feature_removed_from_code->remove_feature_from_docs