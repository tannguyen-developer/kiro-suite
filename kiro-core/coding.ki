# kiro-suite/kiro-core/coding.ki

META:
NAME=global_coding_standards
VERSION=1
PURPOSE=enforce_clean_robust_language_agnostic_code
SCOPE=all_languages_all_engineers
MODE=machine_first
FORMAT=directive_rules_priority_flags

##################################################
# FUNCTIONS & METHODS
##################################################

FUNC=do_one_thing_well
FUNC=prefer_pure_functions_where_possible
FUNC=keep_short_and_focused
FUNC=limit_parameters_to_three_or_use_object
FUNC=command_query_separation
FUNC=return_predictable_types

RULE=func_length_gt_50_lines->consider_refactor
RULE=func_has_side_effects->isolate_and_document
RULE=boolean_flag_argument->split_into_two_functions_or_strategy
RULE=output_parameter_used->return_value_instead

##################################################
# CONTROL FLOW & LOGIC
##################################################

FLOW=prefer_early_returns
FLOW=avoid_deep_nesting
FLOW=avoid_else_blocks_where_possible
FLOW=handle_positive_or_default_conditions_first
FLOW=fail_fast_on_invalid_input

RULE=nesting_level_gt_3->extract_to_function
RULE=complex_conditional->extract_to_variable_with_clear_name
RULE=switch_without_default->require_default_or_exhaustive_check
RULE=loop_with_complex_body->extract_body_to_function

##################################################
# VARIABLES & STATE
##################################################

STATE=prefer_immutability
STATE=minimize_variable_scope
STATE=no_global_state_mutations
STATE=initialize_variables_near_usage
STATE=avoid_shadowing_variables

RULE=variable_reassigned_multiple_times->refactor_data_flow
RULE=magic_number_found->extract_to_named_constant
RULE=magic_string_found->extract_to_enum_or_constant
RULE=mutable_object_passed_as_argument->clone_or_freeze_if_needed

##################################################
# ERROR HANDLING
##################################################

ERR=fail_fast
ERR=never_swallow_errors_silently
ERR=throw_specific_exceptions_not_generic
ERR=prefer_errors_as_values_where_idiomatic
ERR=include_context_in_error_messages
ERR=clean_up_resources_in_finally_or_defer

RULE=empty_catch_block->reject_and_block
RULE=error_caught_but_not_logged_or_handled->require_action
RULE=user_facing_error->sanitize_internal_details
RULE=log_error_with_stacktrace_at_boundaries->enforce

##################################################
# COMMENTS & DOCUMENTATION
##################################################

DOC=code_should_explain_what
DOC=comments_should_explain_why
DOC=avoid_redundant_comments
DOC=update_comments_with_code
DOC=document_public_apis

RULE=comment_repeats_code_logic->remove_comment
RULE=complex_regex->require_explaining_comment
RULE=hack_or_workaround->require_comment_with_ticket_link
RULE=todo_comment->require_ticket_reference

##################################################
# MODULES & DEPENDENCIES
##################################################

MOD=explicit_imports_only
MOD=avoid_circular_imports
MOD=group_and_sort_imports_logically
MOD=depend_on_abstractions_not_concretions

RULE=wildcard_import_used->replace_with_explicit_imports
RULE=unused_import_detected->remove_import
RULE=tight_coupling_to_external_lib->wrap_in_adapter

##################################################
# CONCURRENCY & ASYNC
##################################################

ASYNC=never_block_the_main_thread
ASYNC=prefer_async_await_over_raw_callbacks
ASYNC=handle_promise_rejections
ASYNC=avoid_shared_mutable_state_in_threads

RULE=async_call_without_timeout->add_timeout
RULE=race_condition_risk->use_locks_mutexes_or_atomic_ops
RULE=unhandled_promise_rejection_risk->wrap_in_try_catch

##################################################
# DATA STRUCTURES
##################################################

DATA=use_appropriate_data_structure_for_lookup
DATA=prefer_sets_for_uniqueness
DATA=prefer_maps_dictionaries_for_key_value

RULE=array_lookup_in_large_loop->convert_to_set_or_map
RULE=manual_array_copy->use_built_in_spread_or_clone