# kiro-suite/kiro-core/quality.ki

META:
NAME=global_quality_standards
VERSION=1
PURPOSE=shift_left_testing_and_automated_quality_gates
SCOPE=all_languages_all_projects_all_roles
MODE=machine_first
FORMAT=directive_rules_priority_flags

##################################################
# QUALITY MINDSET & TEST PYRAMID
##################################################

QA=quality_is_everyone_responsibility_not_just_qa_role
QA=shift_left_test_early_test_often
PYRAMID_UNIT=base_layer_fast_isolated_high_volume
PYRAMID_INTEGRATION=middle_layer_slower_verify_boundaries
PYRAMID_E2E=top_layer_slowest_critical_user_journeys_only
TEST=test_behavior_and_outcomes_not_implementation_details
TEST=tests_must_be_deterministic_and_repeatable

RULE=test_fails_intermittently->mark_as_flaky_and_quarantine
RULE=test_tests_private_method_directly->refactor_to_test_public_api
RULE=e2e_test_used_for_simple_edge_case->move_down_to_unit_test

##################################################
# UNIT TESTING
##################################################

UNIT=isolate_completely_from_io_network_and_db
UNIT=fast_execution_measured_in_milliseconds
UNIT=clear_arrange_act_assert_structure
UNIT=one_logical_assertion_concept_per_test
MOCK=mock_external_system_boundaries
MOCK=avoid_mocking_internal_pure_functions_or_domain_logic

RULE=unit_test_makes_network_call->block_and_require_mock
RULE=unit_test_writes_to_local_disk->block_and_require_in_memory
RULE=test_has_no_assertions->reject_as_invalid_test

##################################################
# INTEGRATION & E2E TESTING
##################################################

INT=verify_communication_between_internal_modules
INT=prefer_real_database_via_containers_over_mocks
INT=verify_database_migrations_and_queries
E2E=focus_strictly_on_critical_user_journeys_cuj
E2E=run_against_production_like_environment
E2E=must_clean_up_created_test_data

RULE=integration_test_mocks_database->warn_prefer_ephemeral_db
RULE=e2e_test_pollutes_shared_state_without_cleanup->reject_and_block

##################################################
# CI/CD & AUTOMATED QUALITY GATES
##################################################

GATE=build_compilation_must_pass
GATE=all_active_tests_must_pass
GATE=static_analysis_and_linting_must_pass
GATE=code_formatting_must_match_standard
GATE=security_dependency_scan_must_pass
GATE=no_new_critical_or_high_vulnerabilities_introduced

RULE=overall_test_coverage_drops_below_threshold->fail_build
RULE=new_code_coverage_below_minimum_threshold->fail_build
RULE=linter_reports_error->fail_build_no_exceptions
RULE=vulnerability_found_in_new_dependency->block_merge

##################################################
# PERFORMANCE & OBSERVABILITY IN TESTING
##################################################

PERF=load_test_critical_read_and_write_paths
PERF=define_latency_and_throughput_baselines
OBS=ensure_logs_are_generated_for_errors
OBS=ensure_metrics_track_business_events

RULE=api_response_time_exceeds_sla_in_test->flag_performance_regression
RULE=memory_usage_spikes_during_load_test->flag_memory_leak_risk

##################################################
# TEST MAINTENANCE
##################################################

MAINT=treat_test_code_with_same_respect_as_production_code
MAINT=remove_dead_or_obsolete_tests_promptly
MAINT=refactor_tests_when_refactoring_code
MAINT=keep_test_data_factories_centralized_and_clean

RULE=test_suite_takes_longer_than_15_mins->require_optimization_or_parallelization
RULE=flaky_test_unfixed_for_7_days->delete_or_rewrite