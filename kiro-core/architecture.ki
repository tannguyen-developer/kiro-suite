# kiro-suite/kiro-core/architecture.ki

META:
NAME=global_architecture_standards
VERSION=1
PURPOSE=standardize_system_design_and_data_flow
SCOPE=all_systems_all_architects_all_engineers
MODE=machine_first
FORMAT=directive_rules_priority_flags

##################################################
# ARCHITECTURAL DRIVERS
##################################################

DRIVER=modularity_over_granularity
DRIVER=decoupling_over_reuse
DRIVER=observability_by_default
DRIVER=stateless_preferred
DRIVER=single_source_of_truth
DRIVER=api_first_design

##################################################
# SYSTEM BOUNDARIES & MODULES
##################################################

BOUND=domain_driven_design_preferred
BOUND=bounded_context_must_be_explicit
BOUND=minimize_cross_domain_dependencies
BOUND=avoid_circular_dependencies
BOUND=monolith_first_unless_scale_demands_microservices

RULE=high_coupling_detected->refactor_to_interfaces
RULE=circular_dependency_found->break_via_inversion_of_control
RULE=service_too_small_high_overhead->merge_services
RULE=leaky_abstraction_detected->encapsulate_domain_logic

##################################################
# COMMUNICATION (SYNC VS ASYNC)
##################################################

COMM=async_event_driven_for_state_changes
COMM=sync_rpc_rest_for_queries_only
COMM=choreography_over_orchestration_for_loose_coupling
COMM=orchestration_ok_for_complex_workflows
COMM=idempotency_required_for_all_mutations
COMM=contract_testing_for_api_boundaries

RULE=cross_service_state_change->prefer_message_queue
RULE=high_volume_reads->consider_read_replica
RULE=sync_call_to_external_system->require_circuit_breaker
RULE=sync_call_to_external_system->require_timeout
RULE=api_breaking_change->require_versioning

##################################################
# DATA MANAGEMENT & STORAGE
##################################################

DATA=one_database_per_service
DATA=no_shared_database_integration
DATA=eventual_consistency_acceptable_for_most_cases
DATA=strong_consistency_only_when_business_critical
DATA=cache_invalidation_is_hard_keep_it_simple

RULE=distributed_transaction_needed->use_saga_pattern
RULE=read_heavy_workload->implement_caching_layer
RULE=data_schema_change->require_backward_compatibility
RULE=cross_domain_data_join->use_api_composition_or_cqrs

##################################################
# SCALABILITY & RESILIENCE
##################################################

SCALE=horizontal_scaling_over_vertical
SCALE=stateless_compute_nodes
SCALE=graceful_degradation_under_load
SCALE=fail_fast_and_recover
SCALE=rate_limiting_on_all_public_endpoints
SCALE=load_shedding_under_extreme_stress

RULE=single_point_of_failure_identified->design_redundancy
RULE=downstream_service_slow->return_cached_or_default_response
RULE=memory_leak_risk->enforce_resource_limits
RULE=retry_logic_implemented->require_exponential_backoff_and_jitter

##################################################
# SECURITY IN ARCHITECTURE
##################################################

SEC_ARCH=zero_trust_network_assumption
SEC_ARCH=tls_for_all_transit
SEC_ARCH=secrets_in_vault_never_in_code_or_env_plaintext
SEC_ARCH=identity_context_propagated_via_tokens

RULE=internal_service_to_service->require_mutual_tls_or_auth
RULE=public_exposure->require_api_gateway_or_waf
RULE=user_data_stored->require_encryption_at_rest

##################################################
# STATE MANAGEMENT
##################################################

STATE=push_state_to_edges_or_storage
STATE=avoid_in_memory_session_state
STATE=ui_state_separate_from_server_state

RULE=session_data_required->use_distributed_cache
RULE=background_job_processing->use_persistent_queue

##################################################
# 12-FACTOR APP COMPLIANCE
##################################################

12F=config_in_environment
12F=backing_services_are_attached_resources
12F=build_release_run_strictly_separated
12F=processes_are_stateless_and_share_nothing
12F=treat_logs_as_event_streams

RULE=config_hardcoded_in_source->move_to_env_vars
RULE=local_file_system_for_persistent_data->move_to_object_storage