# kiro-suite/kiro-core/security.ki

META:
NAME=global_security_standards
VERSION=1
PURPOSE=secure_by_default_and_defend_in_depth
SCOPE=all_systems_all_environments_all_roles
MODE=machine_first
FORMAT=directive_rules_priority_flags

##################################################
# CORE SECURITY MINDSET
##################################################

SEC_CORE=secure_by_default
SEC_CORE=defense_in_depth
SEC_CORE=least_privilege_access
SEC_CORE=zero_trust_architecture_assumption
SEC_CORE=deny_by_default_allow_by_exception
SEC_CORE=security_is_continuous_not_a_state

RULE=security_control_bypass_requested->escalate_to_security_team
RULE=tradeoff_security_for_speed->reject_unless_explicit_risk_acceptance_signed

##################################################
# SECRETS MANAGEMENT
##################################################

SECRET=never_hardcode_secrets_in_source_code
SECRET=never_log_secrets_or_credentials
SECRET=use_environment_variables_or_secret_managers
SECRET=rotate_secrets_periodically_and_after_exposure
SECRET=use_short_lived_credentials_where_possible

RULE=secret_found_in_commit->revoke_immediately_and_rewrite_history
RULE=api_key_stored_in_frontend_code->block_and_move_to_backend_proxy

##################################################
# IDENTITY & ACCESS MANAGEMENT (IAM)
##################################################

IAM=authenticate_every_request_at_the_perimeter
IAM=authorize_every_action_at_the_resource_level
IAM=implement_role_based_or_attribute_based_access_control
IAM=use_standard_protocols_like_oauth2_oidc_saml
IAM=require_mfa_for_administrative_or_sensitive_access
IAM=fail_securely_on_auth_errors

RULE=custom_crypto_or_auth_implementation->block_and_require_standard_library
RULE=session_token_without_expiration->reject_and_add_ttl
RULE=missing_authorization_check_on_mutation->block_as_critical_vulnerability

##################################################
# DATA PROTECTION (IN TRANSIT & AT REST)
##################################################

DATA_SEC=encrypt_all_data_in_transit_tls_1_2_minimum
DATA_SEC=encrypt_highly_sensitive_data_at_rest
DATA_SEC=classify_data_sensitivity_public_internal_confidential_restricted
DATA_SEC=minimize_pii_collection_and_retention
DATA_SEC=mask_or_tokenize_sensitive_data_in_non_production_environments

RULE=http_traffic_allowed_in_production->block_and_force_https
RULE=pii_logged_in_application_logs->mask_immediately_and_purge_logs
RULE=production_database_dump_copied_to_local->block_and_alert

##################################################
# INPUT VALIDATION & OUTPUT ENCODING
##################################################

IO_SEC=trust_no_client_input
IO_SEC=validate_input_type_length_format_and_range_strictly
IO_SEC=use_parameterized_queries_for_database_access
IO_SEC=encode_data_on_output_contextually_to_mitigate_injection

RULE=dynamic_sql_concatenation_detected->block_and_require_prepared_statements
RULE=raw_html_rendered_from_user_input->block_and_require_sanitization
RULE=file_upload_without_type_and_malware_scan->block_feature

##################################################
# INFRASTRUCTURE & DEPENDENCY SECURITY
##################################################

INFRA_SEC=keep_all_dependencies_and_os_patched
INFRA_SEC=run_services_with_minimal_os_privileges_non_root
INFRA_SEC=implement_rate_limiting_and_abuse_protection
INFRA_SEC=disable_unnecessary_ports_and_services
INFRA_SEC=scan_container_images_for_vulnerabilities

RULE=container_configured_to_run_as_root->block_and_require_non_root_user
RULE=dependency_has_known_critical_cve->fail_build_and_require_update

##################################################
# LOGGING, AUDITING & INCIDENT RESPONSE
##################################################

AUDIT=log_all_authentication_success_and_failure_events
AUDIT=log_all_authorization_failures
AUDIT=log_all_critical_state_changes_with_actor_identity
AUDIT=append_only_audit_logs_preferred
AUDIT=include_trace_ids_for_cross_service_correlation

RULE=system_lacks_audit_trail_for_financial_transaction->block_release
RULE=security_incident_suspected->trigger_incident_response_playbook