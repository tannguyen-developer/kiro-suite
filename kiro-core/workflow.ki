# kiro-suite/kiro-core/workflow.ki

META:
NAME=global_workflow_standards
VERSION=1
PURPOSE=standardize_collaboration_version_control_and_delivery_flow
SCOPE=all_projects_all_engineers_all_repositories
MODE=machine_first
FORMAT=directive_rules_priority_flags

##################################################
# VERSION CONTROL & BRANCHING STRATEGY
##################################################

VCS=git_is_the_standard
FLOW=trunk_based_development_preferred
FLOW=gitflow_only_for_legacy_or_highly_regulated_releases
BRANCH=short_lived_feature_branches_max_few_days
BRANCH=main_or_master_must_always_be_deployable
BRANCH_NAME_FORMAT=type/ticket-id-short-description

RULE=branch_stale_gt_14_days->warn_or_delete
RULE=direct_commit_to_main->block_and_require_pr
RULE=branch_name_lacks_ticket_id->warn_for_traceability

##################################################
# COMMIT STANDARDS
##################################################

COMMIT=conventional_commits_required_feat_fix_chore_docs_style_refactor_test
COMMIT=atomic_commits_preferred_one_logical_change_per_commit
COMMIT=commit_message_imperative_mood_e_g_add_feature_not_added_feature
COMMIT=include_why_in_body_if_what_is_complex

RULE=commit_message_lacks_conventional_prefix->reject_commit
RULE=commit_message_too_short_lt_10_chars->reject_commit
RULE=commit_contains_multiple_unrelated_changes->warn_suggest_split

##################################################
# PULL REQUEST (PR) / MERGE REQUEST (MR)
##################################################

PR=small_and_focused_easier_to_review
PR=must_link_to_issue_tracker_ticket
PR=must_have_clear_title_and_description_via_template
PR=draft_status_for_wip_do_not_request_review_yet
PR=require_minimum_one_approval_from_code_owner

RULE=pr_diff_gt_400_lines->warn_and_suggest_splitting_pr
RULE=pr_missing_description->block_merge
RULE=pr_ci_checks_failed->block_merge
RULE=pr_approval_from_author_only->block_merge

##################################################
# CODE REVIEW CULTURE
##################################################

REVIEW=review_for_correctness_security_and_maintainability
REVIEW=automate_style_checks_do_not_argue_syntax_in_pr
REVIEW=assume_good_intent
REVIEW=provide_actionable_feedback
REVIEW=approve_with_nitpicks_rather_than_blocking_for_minor_issues

RULE=review_comment_is_nitpick->prefix_with_nit
RULE=review_comment_is_blocking->prefix_with_blocker
RULE=review_turnaround_gt_24_hours->escalate_to_team_chat

##################################################
# CONTINUOUS INTEGRATION & DELIVERY (CI/CD)
##################################################

CI=run_tests_and_linters_on_every_push
CI=build_artifacts_once_deploy_everywhere
CD=automated_deploy_to_staging_on_merge_to_main
CD=production_deploy_requires_manual_gate_unless_fully_mature
RELEASE=use_semantic_versioning_major_minor_patch
RELEASE=immutable_artifacts_never_overwrite_a_published_version

RULE=build_breaks_on_main->highest_priority_fix_drop_everything
RULE=deployment_takes_gt_15_mins->flag_for_pipeline_optimization

##################################################
# ISSUE TRACKING & AGILE FLOW
##################################################

TASK=no_ticket_no_code
TASK=definition_of_ready_must_be_met_before_starting_work
TASK=definition_of_done_must_be_met_before_closing_ticket
STATUS=todo_in_progress_in_review_testing_done

RULE=work_started_but_ticket_not_in_progress->auto_move_ticket
RULE=pr_merged_but_ticket_not_done->auto_move_ticket_to_testing_or_done
RULE=ticket_in_progress_gt_5_days->flag_as_blocked_or_too_large

##################################################
# INCIDENT & HOTFIX WORKFLOW
##################################################

HOTFIX=branch_directly_from_production_tag
HOTFIX=prioritize_mitigation_over_perfect_fix
HOTFIX=must_backport_to_main_after_deploying_to_prod
INCIDENT=blameless_post_mortem_required_for_sev1_sev2

RULE=hotfix_bypasses_ci->reject_unless_system_is_completely_down
RULE=post_mortem_lacks_root_cause_analysis->reject_and_request_rework